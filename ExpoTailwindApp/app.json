{
  "expo": {
    "name": "ExpoTailwindApp",
    "slug": "ExpoTailwindApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expotailwindapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcLpY9pfIZ5lMi3_1zU1-NLv7Cw9LPS9A"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAcLpY9pfIZ5lMi3_1zU1-NLv7Cw9LPS9A"
        }
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vinothstrackit.ExpoTailwindApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleMapsApiKey": "AIzaSyAcLpY9pfIZ5lMi3_1zU1-NLv7Cw9LPS9A",
      "router": {},
      "eas": {
        "projectId": "b84197de-bdc6-4a82-ac10-38f614ed30ed"
      }
    }
  }
}
